# Deployment Configuration
# ========================================

# Citrea RPC URLs
CITREA_TESTNET_RPC=https://rpc.testnet.citreascan.com
CITREA_MAINNET_RPC=https://rpc.citreascan.com

# Private key of deployer wallet (must have cBTC for gas)
# IMPORTANT: Never commit this key to git!
DEPLOYER_PRIVATE_KEY=your_deployer_private_key_here

# Campaign signer address (corresponds to CAMPAIGN_SIGNER_PRIVATE_KEY in API)
# This address will sign claim eligibility proofs
CAMPAIGN_SIGNER_ADDRESS=your_campaign_signer_address_here

# Pinata IPFS JWT Token (get at: https://app.pinata.cloud/developers/api-keys)
# Free tier: Sign up at https://app.pinata.cloud
# Used by create-nft script to upload image and metadata
# When creating API key, enable permissions: pinFileToIPFS and pinJSONToIPFS
PINATA_JWT=your_pinata_jwt_token_here

# ========================================
# Governance Deployment Options
# ========================================

# Transfer ownership of Factory and ProxyAdmin to Governor after deployment
# Set to "true" to transfer ownership (decentralization)
# Set to "false" to deploy contracts only without transferring ownership (default)
# You can always transfer ownership later manually
TRANSFER_OWNERSHIP=false

# ========================================
# USAGE
# ========================================
#
#   Fork testnet:    FORK_TESTNET=true npx hardhat test --network hardhat
#   Fork mainnet:    FORK_MAINNET=true npx hardhat test --network hardhat
#   Deploy fork:     npm run deploy:gov:fork:testnet
#   Deploy testnet:  npm run deploy:gov:testnet
#   Deploy mainnet:  npm run deploy:gov:mainnet
#
#   Start forked node (persistent):
#     npm run node:fork:testnet
#     npm run node:fork:mainnet
#
#   For Governance integration tests (requires Anvil):
#     anvil --fork-url https://rpc.testnet.citreascan.com --chain-id 5115
#     npm run test:gov:anvil

# ========================================
# NOTE: Contract addresses from npm packages
# ========================================
# NO contract addresses are needed in .env!
# All addresses are imported from their canonical npm packages:
#
# From @juicedollar/jusd:
#   - JUSD_ADDRESS (ADDRESS[chainId].juiceDollar)
#   - SV_JUSD_ADDRESS (ADDRESS[chainId].savingsVaultJUSD)
#   - JUICE_ADDRESS (ADDRESS[chainId].equity)
#
# From @juiceswapxyz/sdk-core:
#   - WCBTC_ADDRESS (WETH9[chainId].address)
#   - SWAP_ROUTER_ADDRESS (CHAIN_TO_ADDRESSES_MAP[chainId].swapRouter02Address)
#   - POSITION_MANAGER_ADDRESS (CHAIN_TO_ADDRESSES_MAP[chainId].nonfungiblePositionManagerAddress)
#   - FACTORY_ADDRESS (V3_CORE_FACTORY_ADDRESSES[chainId])
#   - PROXY_ADMIN_ADDRESS (CHAIN_TO_ADDRESSES_MAP[chainId].proxyAdminAddress)
#
# This ensures single source of truth and eliminates sync issues!
