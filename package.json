{
  "name": "@juiceswap/smart-contracts",
  "version": "3.0.0",
  "description": "JuiceSwap Smart Contracts",
  "scripts": {
    "compile": "hardhat compile",
    "prepare": "hardhat compile",
    "test": "hardhat test",
    "node:fork:testnet": "FORK_TESTNET=true npx hardhat node",
    "node:fork:mainnet": "FORK_MAINNET=true npx hardhat node",
    "test:fork:testnet": "FORK_TESTNET=true hardhat test --network hardhat",
    "test:fork:mainnet": "FORK_MAINNET=true hardhat test --network hardhat",
    "test:nft": "hardhat test test/FirstSqueezerNFT.test.ts",
    "test:gov": "hardhat test test/JuiceSwap*.test.ts",
    "test:gov:anvil": "hardhat test test/Governance.integration.ts --network anvilTestnet",
    "test:integration:fork:testnet": "FORK_TESTNET=true hardhat test test/JuiceSwapGateway.integration.ts --network hardhat",
    "test:integration:fork:mainnet": "FORK_MAINNET=true hardhat test test/JuiceSwapGateway.integration.ts --network hardhat",
    "deploy:gateway": "hardhat run scripts/deployJuiceSwapGateway.ts",
    "deploy:gateway:fork:testnet": "FORK_TESTNET=true hardhat run scripts/deployJuiceSwapGateway.ts --network hardhat",
    "deploy:gateway:fork:mainnet": "FORK_MAINNET=true hardhat run scripts/deployJuiceSwapGateway.ts --network hardhat",
    "deploy:gateway:testnet": "hardhat run scripts/deployJuiceSwapGateway.ts --network citreaTestnet",
    "deploy:gateway:mainnet": "hardhat run scripts/deployJuiceSwapGateway.ts --network citrea",
    "deploy:gov": "hardhat run scripts/deploy-governance.ts",
    "deploy:gov:fork:testnet": "FORK_TESTNET=true hardhat run scripts/deploy-governance.ts --network hardhat",
    "deploy:gov:fork:mainnet": "FORK_MAINNET=true hardhat run scripts/deploy-governance.ts --network hardhat",
    "deploy:gov:testnet": "hardhat run scripts/deploy-governance.ts --network citreaTestnet",
    "deploy:gov:mainnet": "hardhat run scripts/deploy-governance.ts --network citrea",
    "deploy:fee-collector-v2": "hardhat run scripts/deploy-fee-collector-v2.ts",
    "deploy:fee-collector-v2:fork:testnet": "FORK_TESTNET=true hardhat run scripts/deploy-fee-collector-v2.ts --network hardhat",
    "deploy:fee-collector-v2:fork:mainnet": "FORK_MAINNET=true hardhat run scripts/deploy-fee-collector-v2.ts --network hardhat",
    "deploy:fee-collector-v2:testnet": "hardhat run scripts/deploy-fee-collector-v2.ts --network citreaTestnet",
    "deploy:fee-collector-v2:mainnet": "hardhat run scripts/deploy-fee-collector-v2.ts --network citrea",
    "verify:gov:testnet": "DEPLOYMENT_FILE_PATH=./deployments/testnet/governance.json npx hardhat run scripts/verifyContracts.ts --network citreaTestnet"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.1.0",
    "viem": "^2.44.0"
  },
  "devDependencies": {
    "@juicedollar/jusd": "^3.0.0",
    "@juiceswapxyz/launchpad": "^3.0.0",
    "@juiceswapxyz/sdk-core": "^3.0.2",
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.5",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.0",
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.10.5",
    "@uniswap/v3-core": "1.0.1",
    "@uniswap/v3-periphery": "1.4.4",
    "axios": "^1.6.2",
    "chai": "^4.3.0",
    "dotenv": "^16.3.1",
    "ethers": "^6.10.0",
    "form-data": "^4.0.0",
    "hardhat": "^2.19.4",
    "hardhat-dependency-compiler": "^1.2.1",
    "hardhat-gas-reporter": "^1.0.0",
    "prettier": "^3.1.1",
    "prettier-plugin-solidity": "^1.2.0",
    "solidity-coverage": "^0.8.0",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
